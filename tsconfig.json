{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",

    /* 🔥 MOST IMPORTANT */
    "jsx": "react-jsx",

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,

    /* ✅ Build Safe */
    "strict": false,
    "skipLibCheck": true,
    "noImplicitAny": false
  },

  "include": ["src"],

  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
